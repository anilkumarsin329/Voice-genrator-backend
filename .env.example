# ---- Server ----
NODE_ENV=production
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=https://admin.example.com
# Set to 1 when running behind nginx / an ALB so rate limiting sees real client IPs
TRUST_PROXY=1

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://user:pass@cluster/brahmakosh

# ---- Auth (admin) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Bootstrap admin, created on first start if no admin exists
ADMIN_EMAIL=admin@brahmakosh.com
ADMIN_PASSWORD=change-me

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=sk_xxx
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_MS=90000
# Optional: pre-configured voices, JSON array. Used when the account's voice list can't be read.
# [{"voiceId":"...","name":"Aditya","style":"devotional_male"},{"voiceId":"...","name":"Ananya","style":"devotional_female"}]
ELEVENLABS_VOICES=

# ---- AWS S3 (private bucket) ----
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-private-bucket
# Optional key prefix inside the bucket, e.g. "brahmakosh-audio"
S3_KEY_PREFIX=brahmakosh-audio
PRESIGN_TTL_SECONDS=3600
# LOCAL DEVELOPMENT ONLY. On EC2 leave these unset and attach an IAM role / instance profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Image generation (DALL-E 3)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# IMAGE_DAILY_LIMIT=200
# IMAGE_MAX_CONCURRENT=2
# S3_IMAGE_PREFIX=brahmakosh-images
